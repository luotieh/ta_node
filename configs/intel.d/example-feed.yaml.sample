# Template for an overlay IOC feed. Copy to e.g. "feedA.yaml" in this directory
# to activate it (only *.yaml / *.yml files are loaded; *.sample is ignored).
items:
  - id: "example-ip-198.51.100.10"
    type: "ip"
    value: "198.51.100.10"
    category: "c2"
    severity: "high"
    source: "example-feed"
    description: "documentation example (TEST-NET-2); disabled so it never matches"
    tags: ["example"]
    enabled: false
  - id: "example-domain-evil.test"
    type: "domain"
    value: "evil.test"
    category: "malware"
    severity: "medium"
    source: "example-feed"
    enabled: false
    expire_at: 0
